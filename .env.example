# Copy to .env and change the password. .env is git-ignored; never commit it.

# Used by docker-compose to create the database.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# Used by the Sentinel server. Keep the credentials in sync with the above.
# Host port is 5433 (see docker-compose.yml).
DATABASE_URL=postgres://sentinel:change-me@localhost:5433/sentinel?sslmode=disable
REDIS_ADDR=localhost:6379
SENTINEL_ADDR=:8080
