# Copy to .env and change the password. .env is git-ignored; never commit it.

# Used by docker-compose to create the database.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# Used by the Sentinel server. Keep the credentials in sync with the above.
# Host port is 5433 (see docker-compose.yml).
DATABASE_URL=postgres://sentinel:change-me@localhost:5433/sentinel?sslmode=disable
REDIS_ADDR=localhost:6379
SENTINEL_ADDR=:8080

# JWT settings for the /v1 API. All three are required; the server will not
# start without them. JWT_SECRET must be at least 32 characters, so the
# placeholder below is deliberately too short: replace it with your own random
# value (see the README for a PowerShell command that generates one).
JWT_SECRET=change-me
JWT_ISSUER=sentinel-dev
JWT_AUDIENCE=sentinel-api
