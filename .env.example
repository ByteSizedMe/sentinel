# Copy to .env and change the password. .env is git-ignored; never commit it.

# Used by docker-compose to create the database.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# Used by the Sentinel server. Keep the credentials in sync with the above.
# Host port is 5433 (see docker-compose.yml).
DATABASE_URL=postgres://sentinel:change-me@localhost:5433/sentinel?sslmode=disable
SENTINEL_ADDR=:8080

# Redis decision cache. If Redis is down the server still works (it asks
# Postgres). CACHE_TTL_SECONDS is how long a cached decision may live: whole
# seconds from 0 to 3600, and 0 turns the cache off. If your Redis has a
# password, put it in the URL (redis://:password@host:6379/0) in your own .env.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# JWT settings for the /v1 API. All three are required; the server will not
# start without them. JWT_SECRET must be at least 32 characters, so the
# placeholder below is deliberately too short: replace it with your own random
# value (see the README for a PowerShell command that generates one).
JWT_SECRET=change-me
JWT_ISSUER=sentinel-dev
JWT_AUDIENCE=sentinel-api

# Rate limits for /v1 (in memory, per process; /health is never limited).
# RPS is requests per second and BURST is how many may arrive at once. The IP
# limit applies before authentication, the caller limit (per token subject)
# after it. An RPS of 0 turns that limiter off. All values are whole numbers;
# MAX_KEYS (at least 100) caps how many IPs and callers are tracked at once.
RATE_LIMIT_IP_RPS=20
RATE_LIMIT_IP_BURST=40
RATE_LIMIT_CALLER_RPS=50
RATE_LIMIT_CALLER_BURST=100
RATE_LIMIT_MAX_KEYS=10000
